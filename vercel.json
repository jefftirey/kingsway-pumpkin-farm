{
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/contact-us",
      "destination": "/#visit",
      "permanent": true
    },
    {
      "source": "/hours-pricing",
      "destination": "/#visit",
      "permanent": true
    },
    {
      "source": "/gallery",
      "destination": "/#photos",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/#about",
      "permanent": true
    },
    {
      "source": "/activities",
      "destination": "/#attractions",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ],
  "trailingSlash": false
}
